# Set to true when Dawah Academy student experience is ready for launch.
VITE_ACADEMY_ENABLED=false

VITE_APP_TITLE="SFU MSA Platform (Local)"
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1

# Optional: keep in sync with backend CMS_MEDIA_MAX_*_KB (defaults match config/cms.php).
# VITE_CMS_MEDIA_MAX_IMAGE_KB=10240
# VITE_CMS_MEDIA_MAX_VIDEO_KB=51200
# VITE_CMS_MEDIA_MAX_DOCUMENT_KB=10240

# Production values (used by npm run build via .env.production):
# VITE_APP_URL=https://sfumsa.ca
# VITE_API_URL=https://api.sfumsa.ca/api/v1

# -----------------------------------------------------------------------------
# Event Management System (EMS)
#
# The EMS is served by this same Vue application at /ems and talks to
# ${VITE_API_URL}/ems, so it needs no API URL of its own. It signs in through
# the platform's existing Sanctum endpoints — there is no separate EMS login,
# and therefore no EMS credentials to configure here.
# -----------------------------------------------------------------------------
