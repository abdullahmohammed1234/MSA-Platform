<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pre-deployment acceptance suite. Synthetic data only; never point it at a
    production database. The <env> values below are defaults, so a MariaDB run
    overrides them from the shell (DB_CONNECTION=mysql, DB_HOST, DB_PORT, ...).
    Each file belongs to exactly one suite so a full run executes it once.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="acceptance-auth">
            <file>tests/Feature/Auth/LoginTest.php</file>
            <file>tests/Feature/Auth/LogoutRevocationVerificationTest.php</file>
            <file>tests/Feature/Auth/TokenLifecycleTest.php</file>
            <file>tests/Feature/Auth/SessionRevocationTest.php</file>
            <file>tests/Feature/Auth/PasswordResetTest.php</file>
            <file>tests/Feature/Auth/EmailVerificationTest.php</file>
            <file>tests/Feature/Auth/SynchronousEmailVerificationTest.php</file>
            <file>tests/Feature/Auth/RegistrationTest.php</file>
            <file>tests/Feature/Security/EmailClaimOwnershipTest.php</file>
        </testsuite>
        <testsuite name="acceptance-roles">
