APP_NAME="SFU MSA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: https://api.sfumsa.ca
FRONTEND_URL=http://localhost:5173
# Production: https://sfumsa.ca — used in emails, CORS, and notification links
# Optional extra CORS origins (comma-separated), e.g. www.sfumsa.ca
# CORS_ALLOWED_ORIGINS=https://www.sfumsa.ca
# SANCTUM_STATEFUL_DOMAINS=sfumsa.ca,www.sfumsa.ca,localhost,localhost:5173
#
# === Production checklist (required) ===
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.example.com
# FRONTEND_URL=https://www.example.com
# FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# LOG_LEVEL=warning
# QUEUE_CONNECTION=database
# TRUSTED_PROXIES=*   # or comma-separated proxy IPs behind cPanel/LB
# FORCE_HTTPS=true when HTTPS is terminated at the reverse proxy
FORCE_HTTPS=false
TRUSTED_PROXIES=*


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The EMS (and the rest of the MSA platform) targets MySQL in development and
# production. SQLite is only used by PHPUnit (in-memory) via phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=msa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production: SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# CMS media upload limits (kilobytes). Ensure PHP upload_max_filesize / post_max_size cover video uploads.
CMS_MEDIA_MAX_IMAGE_KB=10240
CMS_MEDIA_MAX_VIDEO_KB=51200
CMS_MEDIA_MAX_DOCUMENT_KB=10240
# Local may use sync; production MUST use database (or redis) + queue:work
QUEUE_CONNECTION=database


CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no_reply@example.com
MAIL_FROM_NAME="SFU MSA"

# Public website contact form recipient
CONTACT_FORM_RECIPIENT=contact@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Event Management System (EMS)
#
# The EMS is a module inside this application, not a separate service. It
# reuses APP_URL, the database connection, Sanctum and the mail/queue settings
# above; everything below is EMS-specific and optional — the defaults in
# config/ems.php are correct for local development.
###############################################################################

# --- API surface -------------------------------------------------------------
# Where the EMS API is mounted. Change only if it would collide with something.
EMS_API_PREFIX=api/v1/ems
# Requests per minute per authenticated user, enforced by the ems_api limiter.
EMS_API_RATE_LIMIT=120

# --- Public surface (Phase 2) ------------------------------------------------
# Unauthenticated discovery / calendar traffic.
EMS_PUBLIC_RATE_LIMIT=60
# Free registration attempts per IP per minute.
EMS_REGISTRATION_RATE_LIMIT=5
# Public marketing pages (listing, event landing, tickets) — outside /ems admin.
# EMS_PUBLIC_FRONTEND_URL=http://localhost:5173
# Optional absolute base encoded into QR codes, e.g. https://api.example/api/v1/ems/public/tickets/validate
# EMS_TICKET_VALIDATION_URL=

# --- Frontend ----------------------------------------------------------------
# Absolute base URL of the EMS UI, used to build links in future notifications.
# Defaults to "${FRONTEND_URL}/ems".
# EMS_FRONTEND_URL=http://localhost:5173/ems

# --- Logging -----------------------------------------------------------------
# Dedicated daily log channel for EMS operational and audit activity.
EMS_LOG_CHANNEL=ems
EMS_LOG_LEVEL=info
EMS_LOG_DAILY_DAYS=30

# --- Defaults ----------------------------------------------------------------
EMS_DEFAULT_TIMEZONE=America/Vancouver
EMS_DEFAULT_CURRENCY=CAD
EMS_DEFAULT_PER_PAGE=15
EMS_MAX_PER_PAGE=100
EMS_DASHBOARD_UPCOMING_LIMIT=5
EMS_DASHBOARD_ACTIVITY_LIMIT=10

# --- Seeding -----------------------------------------------------------------
# Seeds one development user per EMS role with a randomly generated password
# that is printed to the console. Ignored when APP_ENV=production.
EMS_SEED_DEV_USERS=false

# --- Storage -----------------------------------------------------------------
# Falls back to FILESYSTEM_DISK. Used later for ticket and event assets.
# EMS_STORAGE_DISK=local
# EMS_STORAGE_PATH=ems

###############################################################################
# EMS — deferred / optional phase settings
###############################################################################

# --- Phase 2: ticketing & QR (enabled by default for free tickets) -----------
EMS_TICKETS_ENABLED=true
EMS_TICKET_QR_ENABLED=true
EMS_TICKET_PREFIX=MSA
EMS_TICKET_CODE_LENGTH=10

# --- Phase 3: Square payments ------------------------------------------------
EMS_PAYMENTS_ENABLED=false
EMS_PAYMENT_PROVIDER=square
EMS_PAYMENTS_QUEUE=ems-payments
EMS_WEBHOOK_RATE_LIMIT=120
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_TERMINAL_DEVICE_ID=
SQUARE_API_VERSION=2026-07-15
EMS_CHECKOUT_TTL_MINUTES=1440
# Must match the Square Dashboard notification URL exactly (signature input).
# SQUARE_WEBHOOK_NOTIFICATION_URL="${APP_URL}/api/v1/webhooks/square"

# --- Phase 4: operations & check-in ------------------------------------------
EMS_OPERATIONS_QUEUE=ems-operations
EMS_IMPORT_SYNC_THRESHOLD=50
EMS_CHECK_IN_RATE_LIMIT=60

# --- Phase 5: event communications -------------------------------------------
EMS_NOTIFICATIONS_ENABLED=false
EMS_NOTIFICATIONS_QUEUE=ems-notifications
# EMS_MAIL_FROM_ADDRESS=events@sfumsa.ca
EMS_MAIL_FROM_NAME="SFU MSA Events"
