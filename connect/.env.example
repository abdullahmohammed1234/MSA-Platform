# ==============================================================================
# SFU MSA Connect — Environment Configuration Template
# ==============================================================================
# In local development, leaving VITE_API_BASE_URL blank or setting to /api/v1
# directs requests through Vite's local dev proxy to http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="MSA Connect"

# Optional asset base path (defaults to '/' for root deployment at https://connect.sfumsa.ca)
VITE_BASE_PATH=/
